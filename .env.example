# Development-only defaults. Copy to .env and replace every value marked CHANGE_ME.
DATAHUB_ENV=development
DATAHUB_VERSION=0.1.0-dev
DATAHUB_API_HOST=0.0.0.0
DATAHUB_API_PORT=8000
DATAHUB_LOG_LEVEL=INFO
DATAHUB_DATABASE_URL=postgresql+psycopg://datahub:datahub_dev_password@postgres:5432/datahub
DATAHUB_REDIS_URL=redis://redis:6379/0
DATAHUB_CELERY_BROKER_URL=redis://redis:6379/1
DATAHUB_CELERY_RESULT_BACKEND=redis://redis:6379/2
DATAHUB_S3_ENDPOINT_URL=http://s3:8333
DATAHUB_S3_PUBLIC_ENDPOINT_URL=http://localhost:9410
DATAHUB_S3_REGION=us-east-1
DATAHUB_S3_BUCKET=datahub-private
DATAHUB_S3_ACCESS_KEY=datahub-dev-access
DATAHUB_S3_SECRET_KEY=CHANGE_ME_development_only_secret
DATAHUB_CLAMAV_HOST=clamav
DATAHUB_CLAMAV_PORT=3310
DATAHUB_SMTP_HOST=mailpit
DATAHUB_SMTP_PORT=1025
DATAHUB_FRONTEND_ORIGIN=http://localhost:3410
DATAHUB_SESSION_SECRET=CHANGE_ME_generate_at_least_32_random_bytes
DATAHUB_CSRF_SECRET=CHANGE_ME_generate_a_different_32_byte_secret
DATAHUB_FIELD_ENCRYPTION_KEYS=CHANGE_ME_fernet_key
DATAHUB_ADMIN_MFA_REQUIRED=true
NEXT_PUBLIC_API_BASE_URL=/api/v1
